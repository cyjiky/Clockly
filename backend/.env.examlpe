# JWT Secret
JWT_SECRET_KEY="[jwt key]"

# Postgres
POSTGRES_DSN_PROD="postgresql+asyncpg://[db name]:[db password]@localhost:5432/[dbname_prod]"
POSTGRES_DSN_TEST="postgresql+asyncpg://[db name]:[db password]@localhost:5432/[dbname_test]"

# OAuth 2.0
OAUTH_SECRET="[google oauth secret]"
OAUTH_CLIENT_ID="[google auth client id]"

# App
LOG_LEVEL="DEBUG"